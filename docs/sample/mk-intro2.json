{
  "type": "custom-event",
  "scene": {
    "elementType": "DataSceneElement",
    "payload": {
      "duration": 15000,
      "children": [
        {
          "elementType": "DataSoundElement",
          "id": "sound1",
          "payload": {
            "audioUrl": "/audio/friends/oh-my-god-shes-insane.mp3",
            "children": [
              {
                "elementType": "DataSoundOnPlayBehavior"
              }
            ]
          }
        },
        {
          "elementType": "DataRadialSpawnerElement",
          "id": "spawner1",
          "payload": {
            "countPerWave": 10,
            "spawnVelocity": 3,
            "spawnTemplateIds": ["bouncingImage1", "bouncingImage2"],
            "children": [
              {
                "elementType": "DataSchedulerElement",
                "id": "waveScheduler1",
                "payload": {
                  "interval": 2000,
                  "count": 5
                }
              }
            ]
          }
        },
        {
          "elementType": "DataImageElement",
          "id": "bouncingImage1",
          "payload": {
            "imageUrl": "images/dvd/dvd.png",
            "scale": 1,
            "duration": 3000,
            "children": [
              {
                "elementType": "DataVelocityBehavior",
                "children": [
                  {
                    "elementType": "DataScreenBounceBehavior"
                  }
                ]
              }
            ]
          }
        },
        {
          "elementType": "DataImageElement",
          "id": "bouncingImage2",
          "payload": {
            "imageUrl": "images/dvd/bluRay.png",
            "scale": 1,
            "duration": 3000,
            "children": [
              {
                "elementType": "DataVelocityBehavior",
                "children": [
                  {
                    "elementType": "DataScreenBounceBehavior"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
