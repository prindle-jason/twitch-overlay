{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prndddl.dev/schemas/custom-scene.schema.json",
  "title": "Custom Scene Message",
  "description": "Schema for data-driven scene configuration messages with element-specific validation",
  "type": "object",
  "required": ["type", "scene"],
  "properties": {
    "type": {
      "const": "custom-event",
      "description": "Message type identifier"
    },
    "scene": {
      "$ref": "#/definitions/element",
      "description": "Root scene element (typically DataSceneElement)"
    }
  },
  "definitions": {
    "element": {
      "oneOf": [
        {
          "$ref": "https://prndddl.dev/schemas/elements/DataSceneElement.schema.json"
        },
        {
          "$ref": "https://prndddl.dev/schemas/elements/DataImageElement.schema.json"
        },
        {
          "$ref": "https://prndddl.dev/schemas/elements/DataSoundElement.schema.json"
        },
        {
          "$ref": "https://prndddl.dev/schemas/elements/DataSchedulerElement.schema.json"
        },
        {
          "$ref": "https://prndddl.dev/schemas/elements/DataSoundOnPlayBehavior.schema.json"
        }
      ]
    }
  }
}
